        NoteQuery --> AttachmentNotes
        TimelineService --> ActivityLogsQuery
    end

    MergeAndSort["Merge + Sort<br/>by created_at DESC"]
    Serialize["Serialize via<br/>NoteSerializer / ActivityLogItemSerializer"]
    JSON["JSON Response:<br/>TimelineItem[]"]

    TimelineActivityLog --> ActivityLogsQuery
