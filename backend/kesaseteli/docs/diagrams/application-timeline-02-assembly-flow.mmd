flowchart TD
    subgraph "Signal Layer"
        YouthAppSave["YouthApplication.save()"]
        EmployerAppSave["EmployerApplication.save()"]
        AppPostSaveSignal["post_save Signal<br/>track_*_status_change()"]
    end

    TimelineActivityLog["TimelineActivityLog"]

